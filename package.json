{
  "name": "rn-vconsole-panel",
  "version": "2.0.0",
  "description": "An on-device debug console for React Native — Console, Network, Router stack, Storage and System info panels, the way Chrome DevTools or vConsole work on the web.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "readme.md",
    "readme_CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.build.json",
    "clean": "rimraf lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "react-native",
    "react-native-console",
    "react-native-debugger",
    "vconsole",
    "debugger",
    "devtools",
    "rn-console",
    "rnboat",
    "logger-board",
    "logger",
    "console",
    "network",
    "network-inspector",
    "proxy",
    "stack",
    "storage",
    "asyncstorage",
    "system",
    "monitor",
    "调试面板"
  ],
  "author": "ludejun@live.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludejun/rn-vconsole-panel.git"
  },
  "bugs": {
    "url": "https://github.com/ludejun/rn-vconsole-panel/issues"
  },
  "homepage": "https://github.com/ludejun/rn-vconsole-panel#readme",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.59.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-native": "^0.87.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
